---
/** 静态信息页布局（关于、政策、联系等） */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { SITE } from '@utils/site';
import { normalizePath } from '@utils/url';
import { breadcrumbSchema } from '@utils/schema';
import type { Crumb } from '@utils/schema';

interface Props {
  title: string;
  pageTitle?: string;
  description: string;
  path: string;
  intro?: string;
  schema?: object[];
  noindex?: boolean;
}

const { title, pageTitle, description, path, intro, schema = [], noindex } = Astro.props;
const crumbs: Crumb[] = [
  { name: '首页', path: '/' },
  { name: title, path },
];
---

<BaseLayout
  title={pageTitle ?? `${title}｜${SITE.name}`}
  description={description}
  path={normalizePath(path)}
  schema={[breadcrumbSchema(crumbs), ...schema]}
  noindex={noindex}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <Breadcrumb crumbs={crumbs} />
    <header class="mt-6 max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
        {title}
      </h1>
      {intro && <p class="mt-3 text-base leading-relaxed text-ink-500">{intro}</p>}
    </header>
    <div class="prose prose-slate mt-8 max-w-3xl dark:prose-invert prose-a:text-brand-600 dark:prose-a:text-brand-400">
      <slot />
    </div>
    <slot name="wide" />
  </div>
</BaseLayout>
