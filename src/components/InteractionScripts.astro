---
/**
 * 全站共享的轻量交互脚本：滚动揭示 + 数字计数动画。
 *
 * 两者都是纯粹的渐进增强：
 * - .reveal 元素在没有这段脚本时（爬虫、JS 被禁用、脚本报错）始终保持
 *   CSS 默认的完全可见状态，见 global.css 的 .js-reveal-ready 前缀规则；
 * - data-count-to 元素在没有脚本时直接显示服务端渲染好的最终数字，
 *   脚本只是把"从 0 数上去"的过程做出来，最终值不会因脚本缺失而不同。
 *
 * 只用 IntersectionObserver + requestAnimationFrame，不引入任何依赖。
 */
---

<script is:inline>
  (function () {
    if (!('IntersectionObserver' in window)) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 滚动揭示：进入视口后触发一次即停止观察，不做反复淡入淡出
    const revealTargets = document.querySelectorAll('.reveal');
    if (revealTargets.length > 0) {
      document.documentElement.classList.add('js-reveal-ready');
      const revealObserver = new IntersectionObserver(
        function (entries, observer) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.01 },
      );
      revealTargets.forEach(function (el) {
        revealObserver.observe(el);
      });
    }

    // 数字计数：data-count-to="123" 从 0 平滑数到目标值
    const counters = document.querySelectorAll('[data-count-to]');
    if (counters.length > 0) {
      const animateCounter = function (el) {
        const target = parseFloat(el.getAttribute('data-count-to') || '0');
        const decimals = el.getAttribute('data-count-decimals');
        const decimalPlaces = decimals ? parseInt(decimals, 10) : 0;
        if (prefersReducedMotion) {
          el.textContent = target.toFixed(decimalPlaces);
          return;
        }
        const duration = 900;
        let start = null;
        const from = 0;
        function step(timestamp) {
          if (start === null) start = timestamp;
          const progress = Math.min((timestamp - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3); // ease-out-cubic
          const value = from + (target - from) * eased;
          el.textContent = value.toFixed(decimalPlaces);
          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            el.textContent = target.toFixed(decimalPlaces);
          }
        }
        requestAnimationFrame(step);
      };
      const counterObserver = new IntersectionObserver(
        function (entries, observer) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 },
      );
      counters.forEach(function (el) {
        counterObserver.observe(el);
      });
    }
  })();
</script>
