---
import type { AirportBrand } from '@data/airports/brands';
import { UNLOCK_LABEL } from '@data/airports/brands';

interface Props {
  brands: AirportBrand[];
  caption: string;
  placement?: string;
}
const { brands, caption, placement = 'table' } = Astro.props;
---

<!--
  同一份 <table> 兼顾桌面横向表格与移动端堆叠卡片两种呈现：
  - md 及以上：标准表格 + 横向滚动兜底；
  - md 以下：CSS 将行渲染为卡片，每个单元格用 data-label 提供字段名。
  数据只有一份、排序脚本只操作一套 DOM，不会出现两种视图数据不同步的问题；
  两种视图下真实数据与链接都在原始 HTML 里，抓取与可访问性不受呈现方式影响。
-->
<div class="responsive-table-wrap mt-6 rounded-lg border border-ink-100 dark:border-ink-700/40">
  <table class="responsive-compare-table w-full text-left text-sm" data-brand-table role="table">
    <caption class="sr-only">{caption}</caption>
    <thead class="bg-ink-50 text-ink-900 dark:bg-ink-700/30 dark:text-white" role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader" class="px-4 py-3 font-semibold">机场</th>
        <th scope="col" role="columnheader" class="px-4 py-3 font-semibold">
          <button type="button" data-sort="price" class="inline-flex items-center gap-1 hover:text-brand-600">
            最低价
            <span aria-hidden="true" class="text-ink-300">↕</span>
            <span class="sr-only">按最低价排序</span>
          </button>
        </th>
        <th scope="col" role="columnheader" class="px-4 py-3 font-semibold">流量</th>
        <th scope="col" role="columnheader" class="px-4 py-3 font-semibold">
          <button type="button" data-sort="pergb" class="inline-flex items-center gap-1 hover:text-brand-600">
            每 GB 单价
            <span aria-hidden="true" class="text-ink-300">↕</span>
            <span class="sr-only">按每 GB 单价排序</span>
          </button>
        </th>
        <th scope="col" role="columnheader" class="px-4 py-3 font-semibold">线路</th>
        <th scope="col" role="columnheader" class="px-4 py-3 font-semibold">AI</th>
        <th scope="col" role="columnheader" class="px-4 py-3 font-semibold">流媒体</th>
        <th scope="col" role="columnheader" class="px-4 py-3 font-semibold">优惠码</th>
        <th scope="col" role="columnheader" class="px-4 py-3 font-semibold">链接</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink-100 dark:divide-ink-700/40" role="rowgroup">
      {
        brands.map((brand) => (
          <tr role="row" data-price={brand.minPrice} data-pergb={brand.pricePerGb}>
            <td role="cell" class="cell-name px-4 py-3">
              <a
                href={`/reviews/${brand.slug}/`}
                class="font-medium text-ink-900 hover:text-brand-600 dark:text-white"
              >
                {brand.name}
              </a>
              {brand.house && (
                <span class="ml-1.5 rounded bg-brand-50 px-1.5 py-0.5 text-xs font-semibold text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">
                  自有
                </span>
              )}
            </td>
            <td role="cell" data-label="最低价" class="px-4 py-3 font-semibold text-brand-600 dark:text-brand-400">
              ¥{brand.minPrice}
              <span class="text-xs font-normal text-ink-500">/{brand.minPriceCycle}</span>
            </td>
            <td role="cell" data-label="流量" class="px-4 py-3 text-ink-500">{brand.minTraffic}G</td>
            <td role="cell" data-label="每 GB 单价" class="px-4 py-3 text-ink-500">¥{brand.pricePerGb.toFixed(2)}</td>
            <td role="cell" data-label="线路" class="px-4 py-3 text-ink-500">{brand.lines[0]}</td>
            <td role="cell" data-label="AI" class="px-4 py-3 text-ink-500">{UNLOCK_LABEL[brand.aiSupport]}</td>
            <td role="cell" data-label="流媒体" class="px-4 py-3 text-ink-500">{UNLOCK_LABEL[brand.streamingSupport]}</td>
            <td role="cell" data-label="优惠码" class="px-4 py-3">
              {brand.couponCode ? (
                <code class="rounded bg-ink-50 px-1.5 py-0.5 font-mono text-xs text-ink-700 dark:bg-ink-700/30 dark:text-ink-300">
                  {brand.couponCode}
                </code>
              ) : (
                <span class="text-xs text-ink-500">—</span>
              )}
            </td>
            <td role="cell" class="cell-action px-4 py-3">
              <a
                href={brand.affiliateUrl}
                rel="sponsored nofollow noopener"
                target="_blank"
                data-cta-placement={placement}
                data-cta-brand={brand.slug}
                class="font-medium text-brand-600 hover:underline dark:text-brand-400"
              >
                注册<span class="sr-only">（{brand.name} 推广链接，新窗口打开）</span>
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="mt-2 text-xs text-ink-500">
  <span class="hidden md:inline">表格可左右滑动查看完整字段；</span>
  点击「最低价」「每 GB 单价」可重新排序。价格为品牌方提供的参考信息，请以官网实时页面为准。
</p>

<script>
  // 对比表排序：唯一允许水合的表格交互，纯原生实现；移动端卡片视图与桌面表格
  // 共用同一套 DOM，排序结果对两种呈现方式同时生效，不需要分别处理。
  document.querySelectorAll<HTMLTableElement>('[data-brand-table]').forEach((table) => {
    const tbody = table.querySelector('tbody');
    if (!tbody) return;
    const state = new Map<string, boolean>();
    table.querySelectorAll<HTMLButtonElement>('button[data-sort]').forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.sort;
        if (!key) return;
        const asc = !(state.get(key) ?? false);
        state.set(key, asc);
        const rows = [...tbody.querySelectorAll('tr')];
        rows.sort((a, b) => {
          const av = Number(a.dataset[key] ?? 0);
          const bv = Number(b.dataset[key] ?? 0);
          return asc ? av - bv : bv - av;
        });
        rows.forEach((row) => tbody.appendChild(row));
      });
    });
  });
</script>
