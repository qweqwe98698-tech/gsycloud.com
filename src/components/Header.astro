---
import { NAV_ITEMS, SITE } from '@utils/site';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-ink-100 bg-white/90 backdrop-blur transition-shadow duration-300 dark:border-ink-700/40 dark:bg-ink-900/90"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2" aria-label={`${SITE.name} 首页`}>
      <Logo class="h-8 w-8 transition-transform duration-300 group-hover:scale-105" />
      <span class="text-lg font-bold tracking-tight text-ink-900 dark:text-white">
        GSY <span class="text-brand-600">光速云</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="主导航">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'nav-link relative rounded-md px-3 py-2 text-sm font-medium transition-colors duration-150',
              isActive(item.href)
                ? 'is-active text-brand-700 dark:text-brand-300'
                : 'text-ink-700 hover:bg-ink-50 hover:text-ink-900 dark:text-ink-300 dark:hover:bg-ink-700/30 dark:hover:text-white',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <a
        href="/search/"
        class="rounded-md p-2 text-ink-500 transition-colors duration-150 hover:bg-ink-50 hover:text-ink-900 dark:hover:bg-ink-700/30 dark:hover:text-white"
        aria-label="站内搜索"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
        </svg>
      </a>

      <button
        id="theme-toggle"
        type="button"
        class="rounded-md p-2 text-ink-500 transition-colors duration-150 hover:bg-ink-50 hover:text-ink-900 dark:hover:bg-ink-700/30 dark:hover:text-white"
        aria-label="切换深色模式"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="relative rounded-md p-2 text-ink-500 hover:bg-ink-50 hover:text-ink-900 lg:hidden dark:hover:bg-ink-700/30 dark:hover:text-white"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" id="menu-icon">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu-collapse lg:hidden" aria-label="移动端导航" inert>
    <div class="overflow-hidden">
      <ul class="grid grid-cols-2 gap-1 border-t border-ink-100 bg-white px-4 py-3 dark:border-ink-700/40 dark:bg-ink-900">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-md px-3 py-2 text-sm font-medium transition-colors duration-150',
                  isActive(item.href)
                    ? 'bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300'
                    : 'text-ink-700 hover:bg-ink-50 dark:text-ink-300 dark:hover:bg-ink-700/30',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  // 主题切换（无框架，零水合成本）
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('gsy-theme', isDark ? 'dark' : 'light');
  });

  // 移动端菜单：class 切换 + CSS grid-rows 过渡，展开/收起均为平滑动画
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('is-open') ?? false;
    // inert 与视觉展开状态同步：收起时彻底移出 Tab 顺序与辅助功能树，
    // 展开时恢复可交互；不影响原始 HTML 中链接的存在，抓取不受影响。
    if (isOpen) {
      mobileMenu?.removeAttribute('inert');
    } else {
      mobileMenu?.setAttribute('inert', '');
    }
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? '关闭菜单' : '打开菜单');
    menuToggle.querySelector('#menu-icon path')?.setAttribute(
      'd',
      isOpen ? 'M6 6l12 12M6 18L18 6' : 'M4 6h16M4 12h16M4 18h16',
    );
  });

  // 滚动感知阴影：离开顶部后给 Header 加浮起感，回到顶部时恢复
  const header = document.getElementById('site-header');
  if (header) {
    const applyScrollState = () => {
      header.classList.toggle('shadow-md', window.scrollY > 8);
    };
    applyScrollState();
    window.addEventListener('scroll', applyScrollState, { passive: true });
  }
</script>
