---
import type { RelatedLink } from '@utils/related';

interface Props {
  links: RelatedLink[];
  title?: string;
}
const { links, title = '相关阅读' } = Astro.props;
---

{
  links.length > 0 && (
    <section class="not-prose mt-10" aria-label={title}>
      <h2 class="text-xl font-bold text-ink-900 dark:text-white">{title}</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block h-full rounded-lg border border-ink-100 p-4 transition-colors duration-150 hover:border-brand-300 hover:bg-brand-50/50 dark:border-ink-700/40 dark:hover:border-brand-700 dark:hover:bg-brand-900/20"
            >
              <span class="text-sm font-semibold text-ink-900 dark:text-white">{link.title}</span>
              <span class="mt-1 line-clamp-2 block text-xs leading-relaxed text-ink-500">
                {link.description}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
