---
import type { AirportBrand } from '@data/airports/brands';
import { BRAND_TAG_LABEL, UNLOCK_LABEL } from '@data/airports/brands';
import BrandCta from './BrandCta.astro';

interface Props {
  brand: AirportBrand;
  /** 榜单序号 */
  rank?: number;
  /** 针对当前专题的一句话推荐理由（各专题不同，避免模板化） */
  reason?: string;
  placement?: string;
}

const { brand, rank, reason, placement = 'brand-card' } = Astro.props;
const reviewUrl = `/reviews/${brand.slug}/`;
---

<article
  class="card-lift group flex h-full flex-col rounded-lg border border-ink-100 bg-white p-5 dark:border-ink-700/40 dark:bg-ink-900 dark:hover:border-ink-600"
>
  <header class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        {
          rank !== undefined && (
            <span
              class:list={[
                'inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white',
                rank === 1 ? 'bg-brand-600 ring-2 ring-brand-200 dark:ring-brand-800' : 'bg-ink-400 dark:bg-ink-600',
              ]}
            >
              {rank}
            </span>
          )
        }
        <h3 class="text-base font-bold text-ink-900 dark:text-white">
          <a href={reviewUrl} class="transition-colors duration-150 hover:text-brand-700 dark:hover:text-brand-300">
            {brand.name}
          </a>
        </h3>
        {
          brand.house && (
            <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-700 ring-1 ring-inset ring-brand-200 dark:bg-brand-900/40 dark:text-brand-300 dark:ring-brand-800">
              本站自有品牌
            </span>
          )
        }
      </div>
      <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{brand.tagline}</p>
    </div>
    <div class="shrink-0 text-right">
      <p class="tabular-nums-anim text-xl font-bold text-brand-600 dark:text-brand-400">
        ¥{brand.minPrice}<span class="text-xs font-normal text-ink-500">起</span>
      </p>
      <p class="text-xs text-ink-500">{brand.minTraffic}G / {brand.minPriceCycle}</p>
    </div>
  </header>

  {
    reason && (
      <p class="mt-3 rounded-md bg-ink-50 px-3 py-2 text-sm leading-relaxed text-ink-700 dark:bg-ink-700/20 dark:text-ink-300">
        <span class="font-semibold">推荐理由：</span>
        {reason}
      </p>
    )
  }

  <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
    <div>
      <dt class="text-ink-500">线路</dt>
      <dd class="mt-0.5 font-medium text-ink-900 dark:text-white">{brand.lines.join(' / ')}</dd>
    </div>
    <div>
      <dt class="text-ink-500">协议</dt>
      <dd class="mt-0.5 font-medium text-ink-900 dark:text-white">
        {brand.protocols.length > 0 ? brand.protocols.join(' / ') : '暂未核实'}
      </dd>
    </div>
    <div>
      <dt class="text-ink-500">AI 工具</dt>
      <dd class="mt-0.5 font-medium text-ink-900 dark:text-white">{UNLOCK_LABEL[brand.aiSupport]}</dd>
    </div>
    <div>
      <dt class="text-ink-500">流媒体</dt>
      <dd class="mt-0.5 font-medium text-ink-900 dark:text-white">
        {UNLOCK_LABEL[brand.streamingSupport]}
      </dd>
    </div>
  </dl>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {
      brand.tags.slice(0, 4).map((tag) => (
        <span class="rounded-full bg-ink-50 px-2 py-0.5 text-xs text-ink-500 dark:bg-ink-700/30">
          {BRAND_TAG_LABEL[tag]}
        </span>
      ))
    }
  </div>

  <div class="mt-auto pt-4">
    <BrandCta brand={brand} placement={placement} />
    <a
      href={reviewUrl}
      class="group/more mt-2 inline-flex items-center gap-1 text-xs font-medium text-ink-500 transition-colors duration-150 hover:text-brand-600"
    >
      查看 {brand.name} 完整评测
      <span class="transition-transform duration-150 group-hover/more:translate-x-0.5" aria-hidden="true">→</span>
    </a>
  </div>
</article>
