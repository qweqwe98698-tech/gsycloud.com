---
import type { ContentType, DataStatus } from '@utils/content';
import { formatDate, isoDate } from '@utils/content';
import Badge from './Badge.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  updatedDate: Date;
  contentType?: ContentType;
  dataStatus?: DataStatus;
  category?: string;
}

const { title, description, href, updatedDate, contentType, category } = Astro.props;
---

<article
  class="card-lift group relative flex h-full flex-col overflow-hidden rounded-lg border border-ink-100 bg-white p-5 dark:border-ink-700/40 dark:bg-ink-900 dark:hover:border-ink-600"
>
  <span
    class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-brand-500 to-brand-300 transition-transform duration-300 ease-out group-hover:scale-x-100"
    aria-hidden="true"
  ></span>
  <div class="flex items-center gap-2">
    {contentType && <Badge contentType={contentType} />}
    {category && <span class="text-xs text-ink-500">{category}</span>}
  </div>
  <h3 class="mt-2 text-base font-semibold leading-snug text-ink-900 dark:text-white">
    <a href={href} class="after:absolute after:inset-0 group-hover:text-brand-700 dark:group-hover:text-brand-300">
      {title}
    </a>
  </h3>
  <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-ink-500">{description}</p>
  <p class="mt-3 flex items-center gap-1.5 text-xs text-ink-500">
    <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7v5l3 3" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    更新于 <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
  </p>
</article>
