---
import type { ContentType, DataStatus } from '@utils/content';
import { CONTENT_TYPE_LABEL, DATA_STATUS_LABEL } from '@utils/content';

interface Props {
  contentType?: ContentType;
  dataStatus?: DataStatus;
  text?: string;
  tone?: 'brand' | 'neutral' | 'warning';
}

const { contentType, dataStatus, text, tone } = Astro.props;

let label = text ?? '';
let resolvedTone: 'brand' | 'neutral' | 'warning' = tone ?? 'neutral';

if (contentType) {
  label = CONTENT_TYPE_LABEL[contentType];
  resolvedTone = contentType === 'official' ? 'brand' : 'neutral';
}
if (dataStatus) {
  label = DATA_STATUS_LABEL[dataStatus];
  resolvedTone = dataStatus === 'example' ? 'warning' : 'neutral';
}

const toneClass = {
  brand: 'bg-brand-50 text-brand-700 ring-brand-200 dark:bg-brand-900/40 dark:text-brand-300 dark:ring-brand-800',
  neutral: 'bg-ink-50 text-ink-700 ring-ink-100 dark:bg-ink-700/30 dark:text-ink-300 dark:ring-ink-700/40',
  warning:
    'bg-amber-50 text-amber-800 ring-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:ring-amber-800',
}[resolvedTone];
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset',
    toneClass,
  ]}
>
  {label}
</span>
