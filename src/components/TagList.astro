---
/**
 * 文章标签列表：渲染为指向 /tags/<slug>/ 的可点击链接。
 *
 * 这是站内为数不多会指向标签页的入口——没有它，内容量不足而被 noindex
 * 的标签页固然不需要入链，但符合索引条件的标签页也会变成孤立页面。
 * 同时对用户和生成式搜索都是真实的主题聚类信号，不是只为满足审计而摆设。
 */
import { slugify, normalizePath } from '@utils/url';

interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="not-prose mt-8 flex flex-wrap items-center gap-2" aria-label="文章标签">
      <span class="text-xs font-medium text-ink-500">标签：</span>
      {tags.map((tag) => (
        <a
          href={normalizePath(`/tags/${slugify(tag)}`)}
          class="rounded-full border border-ink-100 px-3 py-1 text-xs text-ink-700 transition-colors duration-150 hover:border-brand-300 hover:text-brand-700 dark:border-ink-700/40 dark:text-ink-300 dark:hover:border-brand-700 dark:hover:text-brand-300"
        >
          {tag}
        </a>
      ))}
    </div>
  )
}
