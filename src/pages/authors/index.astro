---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';

const authors = await getCollection('authors');
---

<PageLayout
  title="作者团队"
  pageTitle="作者团队｜GSY Cloud"
  description="GSY Cloud 内容团队介绍：编辑部与技术组的分工、专业领域与内容职责说明。"
  path="/authors/"
  intro="站内内容由以下团队按编辑政策撰写与审核。"
>
  <p>
    每篇文章都会标注署名团队；内容生产与审核流程见<a href="/editorial-policy/">编辑政策</a>。
  </p>
  <div slot="wide" class="mt-8 grid max-w-3xl gap-5 sm:grid-cols-2">
    {
      authors.map((author) => (
        <div class="rounded-lg border border-ink-100 p-5 dark:border-ink-700/40">
          <h2 class="text-lg font-bold text-ink-900 dark:text-white">
            <a href={`/authors/${author.id}/`} class="hover:text-brand-600">
              {author.data.name}
            </a>
          </h2>
          <p class="mt-0.5 text-sm font-medium text-brand-600 dark:text-brand-400">
            {author.data.role}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">{author.data.bio}</p>
          <p class="mt-3 text-xs text-ink-500">专业领域：{author.data.expertise.join('、')}</p>
        </div>
      ))
    }
  </div>
</PageLayout>
