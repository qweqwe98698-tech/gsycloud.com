---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import Badge from '@components/Badge.astro';
import FaqSection from '@components/FaqSection.astro';
import BrandCta from '@components/BrandCta.astro';
import AffiliateDisclosure from '@components/AffiliateDisclosure.astro';
import { SITE } from '@utils/site';
import { breadcrumbSchema, faqSchema } from '@utils/schema';
import { getBrand } from '@data/airports/brands';

const houseBrand = getBrand('gsycloud');
import {
  SERVICE_CAPABILITIES,
  SERVICE_PLANS,
  SERVICE_FAQ,
  SUPPORTED_CLIENTS,
  SUPPORTED_PROTOCOLS,
  SERVICE_REGIONS,
} from '@data/gsycloud/services';

const crumbs = [
  { name: '首页', path: '/' },
  { name: '服务', path: '/services/' },
];

const description =
  'GSY Cloud 服务介绍：节点覆盖、线路类型、多平台客户端支持、AI 与流媒体使用场景、套餐结构与常见问题，配套完整教程与故障排查支持。';

const icons: Record<string, string> = {
  globe:
    'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.5-2.3 4-5.5 4-9s-1.5-6.7-4-9c-2.5 2.3-4 5.5-4 9s1.5 6.7 4 9Zm-8.5-9h17',
  route: 'M4 19h9a4 4 0 0 0 0-8H8a4 4 0 0 1 0-8h8m-2-2 4 4-4 4',
  devices: 'M3 6h13v10H3zM3 16h13M8 20h8m2-10h3v10h-5V10h2Z',
  ai: 'M12 3v3m0 12v3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1M3 12h3m12 0h3M5.6 18.4l2.1-2.1m8.6-8.6 2.1-2.1',
  play: 'm9 7 8 5-8 5V7Zm-5-3h16v16H4z',
  support: 'M12 21a9 9 0 1 0-9-9m1 9 4-4m8-8 4-4m-16 0 4 4m8 8 4 4',
};
---

<BaseLayout
  title={`GSY Cloud 服务介绍｜节点、线路与套餐说明｜${SITE.name}`}
  description={description}
  path="/services/"
  schema={[breadcrumbSchema(crumbs), faqSchema(SERVICE_FAQ)]}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <Breadcrumb crumbs={crumbs} />

    <header class="mt-6 max-w-3xl">
      <div class="flex items-center gap-2">
        <Badge contentType="official" />
      </div>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
        GSY Cloud 服务介绍
      </h1>
      <p class="mt-3 text-base leading-relaxed text-ink-500">
        GSY Cloud（光速云）是面向中文用户的代理网络服务与知识平台。我们不只提供节点，
        更提供从机场选择、客户端配置到故障排查的完整使用支持，{SITE.slogan}
      </p>
      {
        houseBrand && (
          <div class="mt-6 rounded-lg border border-brand-200 bg-brand-50/50 p-5 dark:border-brand-800 dark:bg-brand-900/20">
            <p class="text-sm text-ink-700 dark:text-ink-300">
              最低套餐 <strong class="text-brand-700 dark:text-brand-300">¥{houseBrand.minPrice} / {houseBrand.minTraffic}G</strong>
              （{houseBrand.minPriceCycle}）· {houseBrand.lines.join(' / ')} · {houseBrand.protocols.join(' / ')}
            </p>
            <div class="mt-3">
              <BrandCta brand={houseBrand} placement="services-hero" size="md" />
            </div>
            <p class="mt-2 text-xs text-ink-500">
              套餐与价格以官网结算页面实时信息为准。想先了解评测视角？查看
              <a href="/reviews/gsycloud/" class="text-brand-600 hover:underline dark:text-brand-400">
                光速云机场评测
              </a>
              ，或在<a href="/brands/" class="text-brand-600 hover:underline dark:text-brand-400">机场品牌库</a>中与其他品牌横向对比。
            </p>
          </div>
        )
      }
      <div class="mt-6">
        <AffiliateDisclosure compact />
      </div>
    </header>

    <section class="mt-12" aria-label="服务能力">
      <h2 class="text-2xl font-bold text-ink-900 dark:text-white">服务能力</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          SERVICE_CAPABILITIES.map((cap) => (
            <div class="rounded-lg border border-ink-100 p-5 dark:border-ink-700/40">
              <svg
                class="h-6 w-6 text-brand-600"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={icons[cap.icon]} />
              </svg>
              <h3 class="mt-3 font-semibold text-ink-900 dark:text-white">{cap.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{cap.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-label="节点与协议">
      <h2 class="text-2xl font-bold text-ink-900 dark:text-white">节点地区与协议支持</h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div class="rounded-lg border border-ink-100 p-5 dark:border-ink-700/40">
          <h3 class="font-semibold text-ink-900 dark:text-white">覆盖地区</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {SERVICE_REGIONS.map((region) => <Badge text={region} tone="neutral" />)}
          </div>
          <p class="mt-3 text-sm text-ink-500">
            常用地区节点用于日常访问，具体节点列表以订阅内实际内容为准。
          </p>
        </div>
        <div class="rounded-lg border border-ink-100 p-5 dark:border-ink-700/40">
          <h3 class="font-semibold text-ink-900 dark:text-white">协议支持</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {SUPPORTED_PROTOCOLS.map((protocol) => <Badge text={protocol} tone="brand" />)}
          </div>
          <p class="mt-3 text-sm text-ink-500">
            想了解各协议的差异，请阅读<a href="/protocols/" class="text-brand-600 hover:underline dark:text-brand-400">协议知识库</a>。
          </p>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-label="客户端支持">
      <h2 class="text-2xl font-bold text-ink-900 dark:text-white">客户端支持</h2>
      <div class="mt-6 overflow-x-auto rounded-lg border border-ink-100 dark:border-ink-700/40">
        <table class="w-full min-w-[480px] text-left text-sm">
          <thead class="bg-ink-50 text-ink-900 dark:bg-ink-700/30 dark:text-white">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">客户端</th>
              <th scope="col" class="px-4 py-3 font-semibold">平台</th>
              <th scope="col" class="px-4 py-3 font-semibold">教程</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100 dark:divide-ink-700/40">
            {
              SUPPORTED_CLIENTS.map((client) => (
                <tr>
                  <td class="px-4 py-3 font-medium text-ink-900 dark:text-white">{client.name}</td>
                  <td class="px-4 py-3 text-ink-500">{client.platform}</td>
                  <td class="px-4 py-3">
                    <a
                      href={client.tutorial}
                      class="text-brand-600 hover:underline dark:text-brand-400"
                    >
                      查看教程 →
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12" aria-label="套餐结构">
      <h2 class="text-2xl font-bold text-ink-900 dark:text-white">套餐结构</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-500">
        以下为套餐结构说明，帮助你理解不同档位的定位差异；具体套餐、流量与价格以官方购买页面实时信息为准。
      </p>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {
          SERVICE_PLANS.map((plan, i) => (
            <div
              class:list={[
                'flex flex-col rounded-lg border p-5',
                i === 1
                  ? 'border-brand-300 ring-1 ring-brand-300 dark:border-brand-700 dark:ring-brand-700'
                  : 'border-ink-100 dark:border-ink-700/40',
              ]}
            >
              <h3 class="text-lg font-bold text-ink-900 dark:text-white">{plan.name}</h3>
              <p class="mt-1 text-sm font-medium text-brand-600 dark:text-brand-400">{plan.cycle}</p>
              <ul class="mt-4 flex-1 space-y-2 text-sm text-ink-500">
                <li>{plan.traffic}</li>
                <li>{plan.devices}</li>
                <li>{plan.highlight}</li>
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12 max-w-3xl" aria-label="如何开始使用">
      <h2 class="text-2xl font-bold text-ink-900 dark:text-white">如何开始使用</h2>
      <ol class="mt-6 space-y-4">
        {
          [
            { step: '选择套餐', desc: '根据设备数量与使用场景选择合适档位。' },
            { step: '获取订阅', desc: '在用户中心复制专属订阅链接，注意妥善保管。' },
            { step: '安装客户端', desc: '按平台选择 Clash、Shadowrocket、v2rayN 等客户端。', href: '/tutorials/' },
            { step: '导入订阅并选择节点', desc: '导入订阅后按延迟与场景选择节点即可使用。' },
            { step: '遇到问题查排查中心', desc: '连接异常时按故障文章逐步排查。', href: '/troubleshooting/' },
          ].map((item, i) => (
            <li class="flex gap-4">
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-bold text-brand-700 dark:bg-brand-900/40 dark:text-brand-300"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div>
                <h3 class="font-semibold text-ink-900 dark:text-white">
                  {item.href ? (
                    <a href={item.href} class="hover:text-brand-600">
                      {item.step}
                    </a>
                  ) : (
                    item.step
                  )}
                </h3>
                <p class="mt-0.5 text-sm text-ink-500">{item.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="max-w-3xl">
      <FaqSection faq={[...SERVICE_FAQ]} />
    </div>
  </div>
</BaseLayout>
