---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE, SECTIONS } from '@utils/site';

const popularSections = ['airport', 'tutorials', 'troubleshooting', 'network'] as const;
---

<BaseLayout
  title={`页面未找到（404）｜${SITE.name}`}
  description="你访问的页面不存在或已被移动。可以通过站内搜索或栏目导航找到需要的内容。"
  path="/404/"
  noindex={true}
>
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold text-brand-600 dark:text-brand-400">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-white">
      页面未找到
    </h1>
    <p class="mt-4 text-base leading-relaxed text-ink-500">
      你访问的页面不存在或已被移动。可以尝试站内搜索，或从下面的栏目继续浏览。
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-brand-700"
      >
        返回首页
      </a>
      <a
        href="/search/"
        class="rounded-md border border-ink-100 px-5 py-2.5 text-sm font-semibold text-ink-700 transition-colors duration-150 hover:bg-ink-50 dark:border-ink-700/40 dark:text-ink-300 dark:hover:bg-ink-700/30"
      >
        站内搜索
      </a>
    </div>
    <div class="mt-10 flex flex-wrap justify-center gap-2">
      {
        popularSections.map((slug) => (
          <a
            href={`/${slug}/`}
            class="rounded-full border border-ink-100 px-4 py-1.5 text-sm font-medium text-ink-700 transition-colors duration-150 hover:border-brand-300 hover:text-brand-700 dark:border-ink-700/40 dark:text-ink-300 dark:hover:border-brand-700 dark:hover:text-brand-300"
          >
            {SECTIONS[slug]?.name}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
