---
import { render } from 'astro:content';
import ReviewLayout from '@layouts/ReviewLayout.astro';
import { getPublished } from '@utils/collections';

export async function getStaticPaths() {
  const entries = await getPublished('reviews');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ReviewLayout id={entry.id} data={entry.data} headings={headings} body={entry.body ?? ''}>
  <Content />
</ReviewLayout>
