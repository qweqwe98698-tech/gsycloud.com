---
import PageLayout from '@layouts/PageLayout.astro';
import { getAllPublished } from '@utils/collections';
import { slugify } from '@utils/url';

const all = await getAllPublished();
const tagCount = new Map<string, { name: string; count: number }>();
for (const { entry } of all) {
  for (const tag of entry.data.tags) {
    const slug = slugify(tag);
    if (!slug) continue;
    const existing = tagCount.get(slug);
    if (existing) existing.count += 1;
    else tagCount.set(slug, { name: tag, count: 1 });
  }
}
const tags = [...tagCount.entries()]
  .map(([slug, { name, count }]) => ({ slug, name, count }))
  .sort((a, b) => b.count - a.count);
---

<PageLayout
  title="标签"
  pageTitle="标签索引｜GSY Cloud"
  description="GSY Cloud 站内内容标签索引，按主题标签浏览机场、客户端、协议与网络知识文章。"
  path="/tags/"
  intro="按标签浏览站内内容。内容较少的标签页不参与搜索引擎索引。"
  noindex={true}
>
  <div slot="wide" class="mt-8 flex max-w-4xl flex-wrap gap-2">
    {
      tags.map((tag) => (
        <a
          href={`/tags/${tag.slug}/`}
          class="rounded-full border border-ink-100 px-4 py-1.5 text-sm font-medium text-ink-700 transition-colors duration-150 hover:border-brand-300 hover:text-brand-700 dark:border-ink-700/40 dark:text-ink-300 dark:hover:border-brand-700 dark:hover:text-brand-300"
        >
          {tag.name}
          <span class="ml-1 text-xs text-ink-500">{tag.count}</span>
        </a>
      ))
    }
  </div>
</PageLayout>
